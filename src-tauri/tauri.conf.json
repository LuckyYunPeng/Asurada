{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asurada",
  "version": "0.5.2",
  "identifier": "com.asurada.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:4721",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ASURADA",
        "width": 52,
        "height": 148,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMUU4QkUxREREODVFODcKUldTSFh0amQ0WXNlY2l5dytZVVhSdFhJSHBtTEcwUDdRTnpOb0ZPblZOK1UyQWxRZnp5ZGliRzMK",
      "endpoints": [
        "https://github.com/LuckyYunPeng/asurada/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
